# Ignore specific folders within the project
__pycache__/
bin/
include/
lib/
share/
etc/

# Additionally, ignore all hidden files and directories
# with the exception of .gitignore and the data directory
.*
!.gitignore
!/data/

# Track the Streamlit theme/server config so deployments match local.
# Never track local secrets: this line must stay AFTER the negation above.
!.streamlit/
.streamlit/secrets.toml

# Ignore the trial file
trial.ipynb

# Exported analytics CSVs
analytics/*.csv
